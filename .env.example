# Copy to .env and adjust. Docker Compose and the test suite both read this file.

# Secret used by Vikunja to sign JWTs (any random string, 32+ chars recommended)
VIKUNJA_SERVICE_SECRET=change-me-to-a-long-random-string

# Base URL of the Vikunja instance under test (optional; defaults to http://127.0.0.1:3456)
# BASE_URL=http://127.0.0.1:3456

# Parallel Playwright workers (optional; defaults to 1). Docker Desktop on Windows drops
# connections when several browsers load the app concurrently, so only raise this on hosts
# where the suite stays green (e.g. Linux).
# WORKERS=1
