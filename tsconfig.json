{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./src/api/*"],
      "@fixtures/*": ["./src/tests/fixtures/*"],
      "@pages/*": ["./src/pages/*"],
      "@locators/*": ["./src/locators/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "playwright.config.ts", "eslint.config.mjs"]
}
